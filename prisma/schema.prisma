// Caltrax database schema (PostgreSQL via Supabase)
//
// Identity/auth lives in Supabase's own `auth.users` table (managed by
// Supabase Auth, not Prisma). Every app table below keys off that user's
// UUID as a plain string column — there is no app-level `User` model to
// keep in sync with it.
//
// Phase 1 covers: profile, goal engine inputs, food database cache, meal
// logging, weight/water logs, reminders. Phase 2+ adds recipes, planner,
// reminders detail, achievements, and wearable-sync tables (stubbed at
// bottom).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection string (Supabase's "Transaction" pooler on port 6543) — used at runtime.
  url       = env("DATABASE_URL")
  // Direct (unpooled) connection (port 5432) — used only for migrations.
  directUrl = env("DIRECT_URL")
}

enum Sex {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum PrimaryGoal {
  LOSE_FAT
  BUILD_MUSCLE
  MAINTAIN_WEIGHT
  IMPROVE_HEALTH
  INCREASE_PROTEIN
  ATHLETIC_PERFORMANCE
  BODY_RECOMPOSITION
}

enum DietaryPreference {
  NONE
  VEGETARIAN
  VEGAN
  KETO
  LOW_CARB
  MEDITERRANEAN
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum FoodSource {
  OPEN_FOOD_FACTS
  USDA
  CUSTOM
}

/// One row per Supabase-authenticated user. `id` is that user's
/// `auth.users.id` (a UUID string) — set explicitly at creation time,
/// never auto-generated, so it always matches the Supabase session.
model Profile {
  id                  String            @id
  name                String?
  sex                 Sex
  age                 Int
  heightCm            Float
  weightKg            Float
  targetWeightKg      Float?
  activityLevel       ActivityLevel
  primaryGoal         PrimaryGoal
  targetRateKgPerWeek Float?
  dietaryPreference   DietaryPreference @default(NONE)
  allergies           String[]          @default([])

  weightUnit          String            @default("kg")
  heightUnit          String            @default("cm")
  volumeUnit          String            @default("ml")

  dailyWaterGoalMl     Int?
  notificationsEnabled Boolean          @default(true)
  /// IANA timezone (e.g. "Europe/London") — needed so reminder times ("HH:mm")
  /// fire at the right moment for this user, not server time. Defaults to UTC
  /// until the client detects and saves the real one (see settings).
  timezone             String           @default("UTC")

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  mealEntries         MealEntry[]
  weightLogs          WeightLog[]
  waterLogs           WaterLog[]
  customFoods         Food[]
  reminders           Reminder[]
  recipes             Recipe[]
  favourites          Favourite[]
  plannedMeals        PlannedMeal[]
  pushSubscriptions   PushSubscription[]
  unlockedAchievements UnlockedAchievement[]
  wearableConnections  WearableConnection[]
  activityLogs         ActivityLog[]
  recipeRatings        RecipeRating[]
  savedRecipes         SavedRecipe[]
  shoppingListItems    ShoppingListItem[]
  workouts             Workout[]
  bodyMeasurements     BodyMeasurement[]
  supplementLogs       SupplementLog[]

  @@map("profiles")
}

/// Cached/normalised food records, whether pulled from Open Food Facts,
/// USDA FoodData Central, or entered manually by a user.
model Food {
  id                  String     @id @default(cuid())
  source              FoodSource
  sourceId            String
  name                String
  brand               String?
  category            String?
  barcode             String?
  servingSizeG        Float?
  servingSizeLabel    String?

  caloriesPer100g     Float
  proteinPer100g      Float
  carbsPer100g        Float
  fatPer100g          Float
  fibrePer100g        Float?
  sugarPer100g        Float?
  saturatedFatPer100g Float?
  sodiumMgPer100g     Float?
  potassiumMgPer100g  Float?
  vitaminAPer100g     Float?
  vitaminCPer100g     Float?
  vitaminDPer100g     Float?
  vitaminEPer100g     Float?
  vitaminKPer100g     Float?
  calciumMgPer100g    Float?
  ironMgPer100g       Float?
  magnesiumMgPer100g  Float?
  zincMgPer100g       Float?

  imageUrl            String?

  ownerId             String?
  owner               Profile?   @relation(fields: [ownerId], references: [id])

  createdAt           DateTime   @default(now())

  mealEntries         MealEntry[]
  recipeItems         RecipeItem[]
  favouritedBy        Favourite[]
  plannedMeals        PlannedMeal[]

  @@unique([source, sourceId])
  @@index([barcode])
  @@map("foods")
}

enum SupplementCategory {
  PROTEIN
  VITAMIN
  MINERAL
  OMEGA3
  PERFORMANCE
  OTHER
}

/// Deliberately a separate model from Food, not a variant of it --
/// supplement dosing is per-serving (a scoop, a capsule, a spray), not
/// per-100g, and most supplements genuinely have no meaningful calorie/
/// macro content at all (a vitamin D capsule isn't "food"). Content here
/// is curated the same way as CURATED recipes: real, accurate,
/// science-grounded facts written for this app, not scraped from or
/// attributed to a specific external database (see prisma/seedSupplements.ts).
model Supplement {
  id                 String             @id @default(cuid())
  name               String
  brand              String?
  category           SupplementCategory
  servingLabel       String
  /// Human-readable summary of the active ingredient(s) and dose per
  /// serving, e.g. "5g Creatine Monohydrate" or "2000 IU (50mcg) Vitamin D3".
  activeIngredient   String
  caloriesPerServing Float?
  proteinPerServing  Float?
  /// A few sentences on what it does, typical timing, and who it suits --
  /// shown on the detail view and reused by goal-based suggestions.
  summary            String
  imageUrl           String?
  createdAt          DateTime           @default(now())
  logs               SupplementLog[]
  knowledgeArticles  KnowledgeArticle[]

  @@index([category])
  @@map("supplements")
}

model SupplementLog {
  id            String     @id @default(cuid())
  userId        String
  user          Profile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplementId  String
  supplement    Supplement @relation(fields: [supplementId], references: [id])
  servingsTaken Float      @default(1)
  loggedAt      DateTime   @default(now())

  @@index([userId, loggedAt])
  @@map("supplement_logs")
}

enum KnowledgeCategory {
  NUTRITION_BASICS
  SUPPLEMENTS
  TRAINING
  RECOVERY
}

/// Educational articles for the "Learn" section. Same content philosophy
/// as CURATED recipes and supplements: real, accurate, carefully-written
/// material (see prisma/knowledgeSeedData.ts), not scraped from or
/// attributed to a specific external source, and framed as general
/// education rather than personalized medical/dosing advice.
model KnowledgeArticle {
  id          String            @id @default(cuid())
  slug        String            @unique
  title       String
  category    KnowledgeCategory
  /// One-line summary shown on the article card and in search results.
  summary     String
  /// Full article body, written as plain paragraphs separated by blank
  /// lines (rendered with simple whitespace-aware formatting) rather than
  /// a markdown/rich-text pipeline this app doesn't otherwise need.
  content     String
  /// Optional link to a specific Supplement this article is most closely
  /// related to (e.g. the "Creatine" article <-> the Creatine Monohydrate
  /// supplement), surfaced as a "related supplement" card.
  relatedSupplementId String?
  relatedSupplement   Supplement? @relation(fields: [relatedSupplementId], references: [id])
  createdAt   DateTime          @default(now())

  @@index([category])
  @@map("knowledge_articles")
}

model MealEntry {
  id              String   @id @default(cuid())
  userId          String
  user            Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodId          String
  food            Food     @relation(fields: [foodId], references: [id])

  mealType        MealType
  servingQuantity Float
  servingUnitG    Float

  loggedAt        DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([userId, loggedAt])
  @@map("meal_entries")
}

model WeightLog {
  id         String   @id @default(cuid())
  userId     String
  user       Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg   Float
  bodyFatPct Float?
  /// "manual" (default) or a WearableProvider value (e.g. "WITHINGS") when
  /// auto-imported from a connected smart scale — lets the UI show "via
  /// Withings" and lets sync logic update today's synced entry instead of
  /// creating a duplicate every time it re-polls.
  source     String   @default("manual")
  loggedAt   DateTime @default(now())

  @@index([userId, loggedAt])
  @@map("weight_logs")
}

enum MeasurementType {
  WAIST
  CHEST
  HIPS
  NECK
  SHOULDERS
  LEFT_ARM
  RIGHT_ARM
  LEFT_THIGH
  RIGHT_THIGH
  LEFT_CALF
  RIGHT_CALF
}

/// Non-scale progress -- body circumference measurements, tracked
/// separately from WeightLog since a person can log any subset of these
/// on a given day (e.g. just waist, not a full set), unlike weight which
/// is always a single value per entry.
model BodyMeasurement {
  id       String          @id @default(cuid())
  userId   String
  user     Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type     MeasurementType
  valueCm  Float
  loggedAt DateTime        @default(now())

  @@index([userId, type, loggedAt])
  @@map("body_measurements")
}

model WaterLog {
  id       String   @id @default(cuid())
  userId   String
  user     Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountMl Int
  loggedAt DateTime @default(now())

  @@index([userId, loggedAt])
  @@map("water_logs")
}

model Reminder {
  id          String    @id @default(cuid())
  userId      String
  user        Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String  // "meal" | "water" | "exercise" | "weight_check" | "supplement" | "custom"
  label       String
  time        String  // "HH:mm" local time
  active      Boolean   @default(true)
  /// Set by the reminders cron after a successful send, compared against
  /// "today" in the user's timezone so a reminder never fires twice in one day
  /// even if the cron window overlaps its target time on two consecutive runs.
  lastFiredAt DateTime?

  @@index([active, time])
  @@map("reminders")
}

/// A browser's Web Push subscription (one per device/browser a user has
/// enabled notifications on). endpoint is unique because re-subscribing
/// the same browser reissues the same endpoint — upsert on it rather than
/// accumulating duplicates.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

// ---------------------------------------------------------------------
// Phase 3 (slice 1): recipes and favourites/quick-add.
// "Recent foods" needs no table of its own — it's derived from MealEntry
// history (distinct foods ordered by loggedAt) at query time.
// ---------------------------------------------------------------------

/// A user-defined bundle of foods that can be logged as a group. Logging a
/// recipe writes one MealEntry per RecipeItem (scaled by servings eaten) —
/// there's no separate "recipe entry" concept, so existing daily-total
/// aggregation (which just sums MealEntry+Food) needs no changes.
enum MealCategory {
  BREAKFAST
  BRUNCH
  LUNCH
  TEA
  SNACK
}

enum RecipeSource {
  /// Professionally-written, seeded content -- browsable by everyone,
  /// not owned by any one user. See prisma/seedRecipes.ts.
  CURATED
  /// Created by a user via the "create your own recipe" form.
  USER
}

model Recipe {
  id          String        @id @default(cuid())
  /// Null for CURATED recipes -- they belong to everyone, not one user.
  /// Required in practice (enforced in app code) for USER recipes.
  userId      String?
  user        Profile?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  source      RecipeSource  @default(USER)
  /// USER recipes are private by default -- only visible in the
  /// creator's own "My Recipes". Explicitly opting in (a checkbox on the
  /// create form) makes it visible to everyone in "User Recipes & Meals"
  /// and to search/logging by other users. Always true for CURATED.
  isPublished Boolean       @default(false)
  name        String
  description String?
  category    MealCategory?
  imageUrl    String?
  servings    Float         @default(1)
  prepMinutes Int?
  cookMinutes Int?
  createdAt   DateTime      @default(now())
  items        RecipeItem[]
  steps        RecipeStep[]
  plannedMeals PlannedMeal[]
  ratings      RecipeRating[]
  savedBy      SavedRecipe[]

  @@index([userId])
  @@index([source, category])
  @@index([source, isPublished])
  @@map("recipes")
}

model RecipeItem {
  id       String @id @default(cuid())
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  foodId   String
  food     Food   @relation(fields: [foodId], references: [id])
  /// Grams of this food in the WHOLE recipe (i.e. across all `Recipe.servings`), not per serving.
  grams    Float
  /// Human-readable ingredient line for display (e.g. "2 cups rolled oats") --
  /// recipes read naturally in cups/tbsp/pieces, not raw grams. Falls back to
  /// a computed "{food.name}, {grams}g" in the UI when null (always true for
  /// recipes created via the plain create-recipe form).
  displayLabel String?

  @@index([recipeId])
  @@map("recipe_items")
}

/// Ordered cooking instructions for a recipe. Curated recipes always have
/// these; user-created recipes may have zero if someone just wants to log
/// ingredients without writing a method.
model RecipeStep {
  id              String @id @default(cuid())
  recipeId        String
  recipe          Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  order           Int
  content         String
  /// Optional -- populates a countdown timer in the cooking UI for steps
  /// like "simmer for 10 minutes".
  durationSeconds Int?

  @@index([recipeId])
  @@map("recipe_steps")
}

/// One star rating per (user, recipe). Average is computed on read, not
/// stored/cached -- recipe rating volume is nowhere near large enough to
/// need that optimization yet.
model RecipeRating {
  id        String   @id @default(cuid())
  userId    String
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId  String
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  stars     Int
  createdAt DateTime @default(now())

  @@unique([userId, recipeId])
  @@map("recipe_ratings")
}

/// A curated recipe someone has bookmarked into "My Recipes" without
/// copying/owning it -- distinct from actually creating one via USER
/// source. Deleting a saved recipe never deletes the underlying Recipe.
model SavedRecipe {
  id        String   @id @default(cuid())
  userId    String
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId  String
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, recipeId])
  @@map("saved_recipes")
}

/// A persistent, accumulating list -- "add to shopping list" on a recipe
/// appends its ingredients here rather than replacing anything, so
/// planning several recipes for the week naturally builds one combined
/// list. Deliberately doesn't attempt to merge/sum quantities across
/// items (e.g. "2 cups rice" + "1 cup rice" -> "3 cups rice") since
/// ingredient units are free-text display labels, not a structured
/// quantity+unit pair that could be safely combined -- checking off or
/// deleting an accidental duplicate is simpler and more reliable than
/// getting automatic merging wrong.
model ShoppingListItem {
  id        String   @id @default(cuid())
  userId    String
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  checked   Boolean  @default(false)
  /// Which recipe this came from, if any -- shown as a small source tag, purely informational (deleting the recipe doesn't remove the item).
  recipeName String?
  createdAt DateTime @default(now())

  @@index([userId, checked])
  @@map("shopping_list_items")
}

enum MuscleGroup {
  CHEST
  BACK
  LEGS
  SHOULDERS
  ARMS
  CORE
  FULL_BODY
  CARDIO
}

/// Curated exercise library -- global reference data, not tied to any
/// one user, same pattern as CURATED recipes and Supplement.
model Exercise {
  id          String        @id @default(cuid())
  name        String
  muscleGroup MuscleGroup
  /// e.g. "Barbell", "Dumbbell", "Bodyweight", "Machine", "Cable" -- free text, purely descriptive.
  equipment   String?
  createdAt   DateTime      @default(now())
  sets        WorkoutSet[]

  @@index([muscleGroup])
  @@map("exercises")
}

/// One training session -- "today's workout" as a single browsable unit,
/// with sets across however many exercises nested underneath. Mirrors
/// how a real workout is actually experienced (several exercises, each
/// with multiple sets) rather than a flat list of unconnected sets.
model Workout {
  id       String       @id @default(cuid())
  userId   String
  user     Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Optional custom name, e.g. "Push Day" -- purely descriptive, not required.
  name     String?
  loggedAt DateTime     @default(now())
  notes    String?
  sets     WorkoutSet[]

  @@index([userId, loggedAt])
  @@map("workouts")
}

model WorkoutSet {
  id         String   @id @default(cuid())
  workoutId  String
  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  setNumber  Int
  reps       Int
  /// Null for bodyweight-only exercises (e.g. plank, push-ups without added load).
  weightKg   Float?
  /// Overall order within the workout, across all exercises, so the UI can display sets in the sequence they were actually logged.
  order      Int

  @@index([workoutId])
  @@map("workout_sets")
}

model Favourite {
  id        String   @id @default(cuid())
  userId    String
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodId    String
  food      Food     @relation(fields: [foodId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, foodId])
  @@map("favourites")
}

// ---------------------------------------------------------------------
// Weekly meal planner. A PlannedMeal is intent, not a log entry — it only
// becomes real data (a MealEntry) when the user marks it eaten, via the
// same logMealAction/logRecipeAction paths used elsewhere. Exactly one of
// foodId/recipeId is set (enforced by a CHECK constraint in the migration,
// since Prisma's schema language has no native XOR-column construct).
// ---------------------------------------------------------------------
model PlannedMeal {
  id       String    @id @default(cuid())
  userId   String
  user     Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Date-only (stored at UTC midnight) — the calendar day this meal is planned for.
  date     DateTime  @db.Date
  mealType MealType

  foodId        String?
  food          Food?   @relation(fields: [foodId], references: [id], onDelete: Cascade)
  servingGrams  Float?

  recipeId      String?
  recipe        Recipe? @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  servingsCount Float?

  notes     String?
  createdAt DateTime @default(now())

  @@index([userId, date])
  @@map("planned_meals")
}

// ---------------------------------------------------------------------
// Achievements/badges. Definitions (label, description, icon, unlock
// criteria) live in code (src/lib/achievements.ts), not the database —
// this table only records the fact and moment a given user met one.
// Persisted (rather than recomputed live) so streak-based badges stay
// unlocked even if the streak later breaks.
// ---------------------------------------------------------------------
model UnlockedAchievement {
  id         String   @id @default(cuid())
  userId     String
  user       Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Matches an id in the ACHIEVEMENTS array in src/lib/achievements.ts.
  key        String
  unlockedAt DateTime @default(now())

  @@unique([userId, key])
  @@map("unlocked_achievements")
}

// ---------------------------------------------------------------------
// Phase 4 (slice 1-2): wearable/device sync via cloud OAuth APIs — Fitbit
// and Withings (slice 1), then Oura and Whoop (slice 2). Apple Health and
// Android Health Connect deliberately aren't here: both are on-device-only
// frameworks with no cloud REST API, so they need the native app wrapper
// (Capacitor/Expo) from a later phase, not this one. Garmin is also not
// here yet — its Health API is push/webhook-based (not poll-for-recent
// like the other four) and needs a formal partner application with real
// review time, so it's deferred until that's actually approved rather than
// guessing at a webhook contract nobody's seen yet.
//
// Tokens are stored as plain columns rather than field-level-encrypted —
// acceptable for now since they're never read outside trusted server
// code (API routes/cron, never sent to the client), same trust boundary
// as DATABASE_URL itself. Revisit with pgcrypto or a KMS-backed column if
// this ever needs a stricter compliance posture (e.g. before handling
// health data at real scale).
//
// Still pending after this: weekly/monthly/yearly report persistence
// (currently computed on demand, not stored), and Garmin/Oura/Whoop.
// ---------------------------------------------------------------------

enum WearableProvider {
  FITBIT
  WITHINGS
  OURA
  WHOOP
}

/// One OAuth connection per (user, provider). Access tokens are short-lived
/// (Fitbit: 8h, Withings: 3h) and refreshed on demand by the sync code using
/// refreshToken — see src/lib/wearables/<provider>.ts.
model WearableConnection {
  id             String           @id @default(cuid())
  userId         String
  user           Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       WearableProvider
  /// The provider's own user identifier, where they expose one (Fitbit does;
  /// Withings' scope covers only the connecting user, so this stays null there).
  externalUserId String?
  accessToken    String
  refreshToken   String
  expiresAt      DateTime
  scope          String?
  lastSyncedAt   DateTime?
  /// Set on a failed sync (e.g. revoked access) so the UI can surface
  /// "reconnect needed" instead of silently going stale.
  lastSyncError  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, provider])
  @@map("wearable_connections")
}

/// Daily activity summary synced from a wearable. One row per (user, date,
/// source) — kept per-provider rather than merged, so switching devices
/// mid-month never silently overwrites another device's history for the
/// same day.
model ActivityLog {
  id               String           @id @default(cuid())
  userId           String
  user             Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Date-only (stored at UTC midnight) — the calendar day this activity is for.
  date             DateTime         @db.Date
  source           WearableProvider
  steps            Int?
  activeCalories   Int?
  restingHeartRate Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([userId, date, source])
  @@index([userId, date])
  @@map("activity_logs")
}
